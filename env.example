# Server-only configuration. Every value here is read inside the Next.js server
# process (lib/server/config.ts) and is never bundled into client code, returned
# in an API response, or accepted from a request body/query string.
#
# Deposit monitoring needs a JSON-RPC endpoint supplied in EITHER of these two
# shapes — you do not need both:
#   (a) ALCHEMY_RPC_URL alone, the complete endpoint copied from the Alchemy
#       dashboard (Apps -> your app -> HTTPS). Used exactly as given.
#   (b) ALCHEMY_API_KEY + ALCHEMY_NETWORK, from which the endpoint is built.

# Full Alchemy JSON-RPC endpoint. Get it from dashboard.alchemy.com -> your app
# -> HTTPS URL (shape: https://<network>.g.alchemy.com/v2/<key>). When set it is
# used intact: no key or network segment is ever appended to it.
ALCHEMY_RPC_URL=

# Alchemy API key, used together with ALCHEMY_NETWORK to build the endpoint.
# Get it from dashboard.alchemy.com -> your app -> API key.
ALCHEMY_API_KEY=

# Alchemy network, in any of the accepted shapes: robinhood-mainnet,
# ROBINHOOD_MAINNET, or the full https://<network>.g.alchemy.com/v2/<key> URL.
# Required when only ALCHEMY_API_KEY is set; otherwise the network is read from
# ALCHEMY_RPC_URL's hostname.
ALCHEMY_NETWORK=

# Alchemy Notify token, used to register each deposit address on the Address
# Activity webhook. Get it from dashboard.alchemy.com -> Notify -> Auth token.
ALCHEMY_NOTIFY_AUTH_TOKEN=

# Alchemy Address Activity webhook id (dashboard.alchemy.com -> Notify -> your
# webhook). The webhook route stays closed until this is set.
ALCHEMY_WEBHOOK_ID=

# Alchemy webhook signing key, used to verify the HMAC-SHA256 signature on every
# delivery (dashboard.alchemy.com -> Notify -> your webhook -> Signing key).
ALCHEMY_WEBHOOK_SIGNING_KEY=

# Optional: shared bearer secret pinned on the webhook URL, if you set one.
ALCHEMY_WEBHOOK_AUTH_TOKEN=

# Optional: webhook URL to create a webhook from when no ALCHEMY_WEBHOOK_ID is
# configured (e.g. https://your-app.vercel.app/api/funding/webhook).
ALCHEMY_WEBHOOK_URL=

# Privy credentials for session verification (the only access requirement).
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Optional: Privy wallet-api authorization key, only needed when the Privy app
# has an authorization keypair enabled for server wallet creation.
PRIVY_WALLET_AUTHORIZATION_PRIVATE_KEY=

# Postgres connection (DATABASE_URL, or the PGHOST/PGUSER/PGPASSWORD/PGDATABASE
# group).
DATABASE_URL=

# Bearer secret that authorizes the scheduled crons: /api/funding/reconcile
# (every 10 minutes) and /api/gpu/sweep (daily). Vercel sends it automatically as
# `Authorization: Bearer $CRON_SECRET`; without it both endpoints stay closed
# and answer 503 with an explicit code. Pick any long random string.
CRON_SECRET=

# --- Funding reconciliation tuning (all optional; defaults shown) ---

# How many blocks the polling fallback scans per eth_getLogs call. The first run
# looks back exactly this many blocks from chain head; a larger gap on later runs
# is split into windows of this size rather than one oversized query.
# Default: 5000
FUNDING_RECONCILE_CHUNK_BLOCKS=5000

# How many deposit addresses one sweep may scan. Least recently scanned first, so
# a backlog drains across consecutive runs.
# Default: 25
FUNDING_RECONCILE_MAX_WALLETS=25

# On-chain confirmations required before a USDG deposit is credited. Measured as
# depth from the transfer's inclusion block to the current chain head.
# Default: 3 (the product requirement)
# FUNDING_CONFIRMATIONS=3

# Smallest deposit that receives credit, in whole USDG tokens. Default: 0 (any
# positive amount).
# FUNDING_MIN_DEPOSIT_TOKENS=0

# How many attempts an Alchemy address registration may make before it stops
# retrying. Default: 8 (with exponential backoff capped at one hour).
# FUNDING_REGISTRATION_MAX_ATTEMPTS=8
